# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth and GitHub OAuth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Current embedding configuration. CiteSeek will replace this with a hosted,
# non-OpenAI provider in a later milestone.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=replace-with-provider-api-key
# LOCAL_EMBEDDING_BASE_URL=http://localhost:1234/v1

# Ingestion workflows
CRON_SECRET=replace-with-a-random-cron-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-google-oauth-refresh-token

# Search rate limit
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_HOURS=24
